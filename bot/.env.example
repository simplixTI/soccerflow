# Server
PORT=3000

# DeepSeek (get a key at https://platform.deepseek.com)
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_MODEL=deepseek-chat

# Twilio (SMS)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# The Twilio phone number parents text, in E.164 format (used to SMS the owner)
TWILIO_PHONE_NUMBER=+18584454126
# Set to "false" to skip X-Twilio-Signature validation (local dev only!)
TWILIO_VALIDATE_SIGNATURE=true

# uazapi (WhatsApp)
UAZAPI_BASE_URL=https://your-instance.uazapi.com
UAZAPI_TOKEN=your_uazapi_token

# Owner notifications
OWNER_WHATSAPP_NUMBER=18584454126
OWNER_SMS_NUMBER=+18584454126

# Admin panel (/admin) — password to teach the AI
ADMIN_TOKEN=generate-a-random-token
